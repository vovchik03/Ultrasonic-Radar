<Window x:Class="Radar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Radar"
        xmlns:controls="clr-namespace:Radar.Controls"
        mc:Ignorable="d"
        Title="Radar TEST" Height="600" Width="880">
    <Window.Resources>
        <Style x:Key="RoundButton" TargetType="Button">
            <Setter Property="Width" Value="75" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10" />
                </Style>
            </Style.Resources>
        </Style>

        <Style x:Key="AngleBox" TargetType="TextBox">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MaxLength" Value="3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <EventSetter Event="PreviewTextInput" Handler="AngleBox_PreviewTextInput" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <!-- Top part (3/4): click = GOTO the angle, drag = SCAN the sector -->
        <controls:RadarView Grid.Row="0" x:Name="RadarScreen" />

        <!-- Link lamp: red = the radar does not answer, green = it does -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="14,12,0,0" IsHitTestVisible="False">
            <Ellipse x:Name="LinkLamp" Width="12" Height="12" Fill="#E24B4A">
                <Ellipse.Effect>
                    <DropShadowEffect x:Name="LinkGlow" Color="#E24B4A" BlurRadius="10" ShadowDepth="0" Opacity="0.9" />
                </Ellipse.Effect>
            </Ellipse>
            <TextBlock x:Name="LinkText" Text="no link" Margin="8,0,0,0" VerticalAlignment="Center"
                       FontFamily="Consolas" FontSize="13" Foreground="#7A8B4A" />
        </StackPanel>

        <!-- Bottom part (1/4) -->
        <Border Grid.Row="1" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
            <Grid Margin="20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Left: where the radar is -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Port" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="PortBox" Width="80" Height="24"
                                  DropDownOpened="PortBox_DropDownOpened" SelectionChanged="PortBox_SelectionChanged" />
                    </StackPanel>
                    <!-- Simulated radar instead of the COM port -->
                    <CheckBox x:Name="DemoBox" Content="Demo" Margin="0,10,0,0"
                              Checked="DemoBox_Checked" Unchecked="DemoBox_Unchecked" />
                </StackPanel>

                <!-- Center: each field with its button under it.
                     Start sends "SCAN <from> <to>", GoTo sends "GOTO <angle>", angles 0..180° -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="FromBox" Text="0" Style="{StaticResource AngleBox}" Margin="0,0,10,0" />
                            <TextBlock Text="To" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="ToBox" Text="180" Style="{StaticResource AngleBox}" />
                        </StackPanel>
                        <Button x:Name="StartButton" Content="Start" Style="{StaticResource RoundButton}"
                                IsDefault="True" Margin="0,8,0,0" Click="StartButton_Click" />
                    </StackPanel>

                    <StackPanel Margin="40,0,0,0">
                        <!-- Enter in the box presses GoTo instead of the default Start -->
                        <TextBox x:Name="GoToBox" Text="90" Style="{StaticResource AngleBox}"
                                 PreviewKeyDown="GoToBox_PreviewKeyDown" />
                        <Button x:Name="GoToButton" Content="GoTo" Style="{StaticResource RoundButton}"
                                Margin="0,8,0,0" Click="GoToButton_Click" />
                    </StackPanel>
                </StackPanel>

                <!-- Right: servo speed, "SPEED <deg/s>" + the matching "STEP <deg>",
                     sent when the slider stops moving -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Width="230">
                    <DockPanel>
                        <TextBlock x:Name="SpeedText" DockPanel.Dock="Right" Text="90 °/s · step 5°" FontWeight="SemiBold" />
                        <TextBlock Text="Servo speed" />
                    </DockPanel>
                    <Slider x:Name="SpeedSlider" Minimum="30" Maximum="210" Value="90" Margin="0,6,0,0"
                            TickFrequency="10" IsSnapToTickEnabled="True" SmallChange="10" LargeChange="30"
                            IsSelectionRangeEnabled="True" SelectionStart="90" SelectionEnd="160"
                            ValueChanged="SpeedSlider_ValueChanged" />
                    <TextBlock Text="slower = finer step, 90..160 recommended" FontSize="11" Foreground="Gray" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Last reply from the radar or the port error -->
                <TextBlock x:Name="StatusText" Grid.Row="1" Grid.ColumnSpan="3" HorizontalAlignment="Center"
                           Margin="0,6,0,0" Foreground="Gray" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Window>
