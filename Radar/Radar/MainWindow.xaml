<Window x:Class="Radar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Radar"
        xmlns:controls="clr-namespace:Radar.Controls"
        mc:Ignorable="d"
        Title="Radar TEST" Height="450" Width="500">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <!-- Top part (3/4) -->
        <controls:RadarView Grid.Row="0" x:Name="RadarScreen" />

        <!-- Bottom part (1/4) -->
        <Border Grid.Row="1" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Port" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="PortBox" Width="80" Height="24" Margin="0,0,16,0"
                              DropDownOpened="PortBox_DropDownOpened" SelectionChanged="PortBox_SelectionChanged" />
                    <Button x:Name="TestButton" Content="Test Button" Width="75" Height="40" Cursor="Hand" IsCancel="True" Click="TestButton_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <!-- Last reply from the radar or the port error -->
                <TextBlock x:Name="StatusText" HorizontalAlignment="Center" Margin="10,8,10,0"
                           Foreground="Gray" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
